#!/usr/bin/env python3
"""
Bonus grading script: extra edge-case validations for MP3.
Focus:
- Lazy allocation holes remain untouched before first fault
- Faulted page has full flags V R W X U
- Swapped page PTE encoding correctness (no V, has S, blockno alignment)
- Shrink after fault removes the faulted page cleanly
- Consistency checks on block number -> pa and PTE composition

This script re-runs existing user test binaries (mp3_2, mp3_3) and
adds stricter structural checks beyond public tests.
"""
import re
from gradelib import *
from gradeutil_mp3_public import (
    _match_baseline_pagetable,
    _match_pagetable_with_faulted_page,
    _match_madvise_pagetable,
)

runner = Runner(save("xv6.out.bonus"))

# ----------------------------------------------------------------------
# Helper parsing utilities (specialized for bonus edge checks)
# ----------------------------------------------------------------------

def _extract_pagetable_sections(output):
    """Return list of (header_line, block_of_lines) for each page table dump."""
    sections = []
    lines = output.splitlines()
    current = None
    buf = []
    for line in lines:
        if re.match(r"^page table 0x[0-9a-f]+$", line):
            if current:
                sections.append((current, buf))
            current = line
            buf = []
        elif current:
            # accumulate until blank line followed by non-indented or next header
            buf.append(line)
    if current:
        sections.append((current, buf))
    return sections


def _find_line(lines, pattern):
    for ln in lines:
        if re.match(pattern, ln):
            return ln
    return None


def _parse_pte(line):
    """Parse a single leaf PTE line: returns dict with pte, va, pa, flags, blockno(optional)."""
    m_pte = re.search(r"pte=0x([0-9a-f]+)", line)
    m_va = re.search(r"va=0x([0-9a-f]+)", line)
    m_pa = re.search(r"pa=0x([0-9a-f]+)", line)
    blockno = None
    if "blockno=" in line:
        m_blk = re.search(r"blockno=0x([0-9a-f]+)", line)
        if m_blk:
            blockno = int(m_blk.group(1), 16)
    flags_part = line.split()
    # flags are trailing tokens consisting of single letters V/R/W/X/U/S
    flag_tokens = [t for t in flags_part if re.match(r"^[VRW XUS]$", t)]
    # When swapped, pattern prints flags after blockno value
    # More robust: gather tokens that are exactly length 1 and in the set
    all_flags = []
    for tok in flags_part:
        if tok in ("V", "R", "W", "X", "U", "S"):
            all_flags.append(tok)
    return {
        "pte": int(m_pte.group(1), 16) if m_pte else None,
        "va": int(m_va.group(1), 16) if m_va else None,
        "pa": int(m_pa.group(1), 16) if m_pa else None,
        "blockno": blockno,
        "flags": all_flags,
        "raw": line,
    }


def _assert(condition, msg):
    if not condition:
        raise AssertionError(msg)

# ----------------------------------------------------------------------
# Bonus Tests
# ----------------------------------------------------------------------

@test(0, "bonus: lazy holes remain unchanged (mp3_2)")
def test_bonus_lazy_holes():
    runner.run_qemu(shell_script(["mp3_2"]))
    # Collect page table sections
    secs = _extract_pagetable_sections(runner.qemu.output)
    # Expect at least 6 dumps (baseline stages + fault + final)
    _assert(len(secs) >= 6, f"Expected >=6 page table dumps, got {len(secs)}")
    # Verify first two (Before/After sbrk growth) identical in leaf mappings count
    before_leafs = [ln for ln in secs[0][1] if re.match(r"^\s+\d+: pte=0x", ln)]
    after_leafs = [ln for ln in secs[1][1] if re.match(r"^\s+\d+: pte=0x", ln)]
    _assert(len(before_leafs) == len(after_leafs), "Leaf PTE count changed before fault under lazy allocation")

@test(0, "bonus: faulted page full flags (mp3_2)")
def test_bonus_fault_flags():
    runner.run_qemu(shell_script(["mp3_2"]))
    # Find faulted page section
    fault_header_index = None
    lines = runner.qemu.output.splitlines()
    for idx, ln in enumerate(lines):
        if re.match(r"^# After page fault", ln):
            fault_header_index = idx
            break
    _assert(fault_header_index is not None, "Missing fault header line")
    # From that point, next page table dump
    for j in range(fault_header_index + 1, len(lines)):
        if re.match(r"^page table 0x", lines[j]):
            # scan following lines until blank
            dump_lines = []
            for k in range(j + 1, len(lines)):
                if lines[k].strip() == "":
                    break
                dump_lines.append(lines[k])
            fault_line = _find_line(dump_lines, r"^\s+5: pte=0x[0-9a-f]+ va=0x0000000000005000 pa=0x[0-9a-f]+ V R W X U$")
            _assert(fault_line is not None, "Faulted page line with full flags not found")
            parsed = _parse_pte(fault_line)
            # Check flags set
            for fl in ["V", "R", "W", "X", "U"]:
                _assert(fl in parsed["flags"], f"Missing flag {fl} on faulted page")
            return
    raise AssertionError("Did not locate page table after fault header")

@test(0, "bonus: shrink removes faulted page (mp3_2)")
def test_bonus_shrink_removes_fault():
    runner.run_qemu(shell_script(["mp3_2"]))
    # Find final shrink page table
    shrink_header_index = None
    lines = runner.qemu.output.splitlines()
    for idx, ln in enumerate(lines):
        if re.match(r"^# After sbrk\(-PGSIZE \* 2\) again", ln):
            shrink_header_index = idx
    _assert(shrink_header_index is not None, "Missing shrink-again header")
    # parse subsequent page table
    for j in range(shrink_header_index + 1, len(lines)):
        if re.match(r"^page table 0x", lines[j]):
            dump_lines = []
            for k in range(j + 1, len(lines)):
                if lines[k].strip() == "":
                    break
                dump_lines.append(lines[k])
            # Faulted VA=0x5000 should be absent
            absent = all(not re.search(r"va=0x0000000000005000", ln) for ln in dump_lines)
            _assert(absent, "Faulted page still present after shrink")
            return
    raise AssertionError("Final page table after shrink not found")

@test(0, "bonus: swapped page encoding correctness (mp3_3)")
def test_bonus_swapped_encoding():
    runner.run_qemu(shell_script(["mp3_3"]))
    # Simple validation - just find the swapped line and verify encoding
    runner.match(r"^# After madvise\(\)")
    runner.match(r"^page table 0x[0-9a-f]+")
    
    # Find swapped page line in output
    lines = runner.qemu.output.splitlines()
    swapped_line = None
    for ln in lines:
        if re.search(r"5: pte=0x[0-9a-f]+ va=0x0000000000005000.*blockno=0x[0-9a-f]+.*S", ln):
            swapped_line = ln
            break
    _assert(swapped_line is not None, "Swapped page line not found")
    
    parsed = _parse_pte(swapped_line)
    _assert("V" not in parsed["flags"], "Swapped page erroneously still has V flag")
    _assert("S" in parsed["flags"], "Swapped page missing S flag")
    _assert(parsed["blockno"] is not None, "Missing blockno in swapped line")
    # Alignment: blockno must be multiple of 8 (balloc_page allocates 8 blocks)
    _assert(parsed["blockno"] % 8 == 0, f"Block number {parsed['blockno']} not 8-aligned")
    # PA relation: printed pa should equal blockno << 12 (spec display)
    expected_pa = parsed["blockno"] << 12
    _assert(parsed["pa"] == expected_pa, f"Swapped display pa mismatch: got 0x{parsed['pa']:x} expected 0x{expected_pa:x}")
    # PTE composition: high bits store blockno (<<10); ensure pte >>10 == blockno
    _assert((parsed["pte"] >> 10) == parsed["blockno"], "PTE high bits do not store blockno correctly")

@test(0, "bonus: swapped page flags stripped of V only")
def test_bonus_swapped_flags_strip():
    runner.run_qemu(shell_script(["mp3_3"]))
    # Simple validation without full pagetable match
    runner.match(r"^# After madvise\(\)")
    runner.match(r"^page table 0x[0-9a-f]+")
    
    # Find and parse the swapped line
    lines = runner.qemu.output.splitlines()
    swapped_line = None
    for ln in lines:
        if re.search(r"5: pte=0x[0-9a-f]+ va=0x0000000000005000.*blockno=0x[0-9a-f]+.*S", ln):
            swapped_line = ln
            break
    _assert(swapped_line is not None, "Swapped page line not found")
    
    parsed = _parse_pte(swapped_line)
    for fl in ["R", "W", "X", "U", "S"]:
        _assert(fl in parsed["flags"], f"Flag {fl} missing after swap-out")
    _assert("V" not in parsed["flags"], "V flag not cleared on swap-out")

